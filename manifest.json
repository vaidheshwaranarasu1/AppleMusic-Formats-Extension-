{
  "manifest_version": 3,
  "name": "AppleMusic Formats",
  "description": "Shows available audio formats and 4K indicators on Apple Music album and music-video pages.",
  "version": "1.0.0",
  "icons": {
    "16": "logo/16.png",
    "48": "logo/48.png",
    "128": "logo/128.png"
  },
  "host_permissions": [
    "https://music.apple.com/*",
    "https://amp-api.music.apple.com/*"
  ],
  "content_scripts": [
    {
      "js": [
        "content.js"
      ],
      "matches": [
        "https://music.apple.com/*/album/*",
        "https://music.apple.com/*/music-video/*"
      ]
    }
  ]
}
